  universal_storage_filesystem:
    path: ../../universal_storage/pkgs/universal_storage_filesystem
  universal_storage_live_apply:
    path: ../../universal_storage/pkgs/universal_storage_live_apply
  universal_storage_mesh_transport:
    path: ../../universal_storage/pkgs/universal_storage_mesh_transport

  agentic_executables_wire:
    path: ../../agentic_executables/agentic_executables_wire

  # oka 0.9.x dev (pub.dev latest is 0.8.1)
  oka_core:
    path: /Users/antonio/xs/oka/packages/oka_core
  oka_supervisor:
    path: /Users/antonio/xs/oka/packages/oka_supervisor
